# Python
__pycache__/
*.pyc
*.pyo

# venv (created by vendor/venv-jax / vendor/venv-torch install scripts)
.venv/
vendor/venv-jax/.venv/
vendor/venv-torch/.venv/

# Compiled kernels — platform/arch specific, rebuild on target (see vendor/FlashRT/README.md)
# NOTE: the aarch64/Py3.12 runtime kernels ARE committed (self-contained clone).
# Other compiled artifacts stay ignored.
*.so
*.so.*
!vendor/FlashRT/flash_rt/flash_rt_kernels*.so
!vendor/FlashRT/flash_rt/flash_rt_fp4*.so
!vendor/FlashRT/flash_rt/libfmha_fp16_strided.so

# Model weights (large, download via scripts/download_checkpoint.sh)
ckpt/
checkpoints/
*.safetensors

# Logs / eval results
*.log
eval_result/
eval_summary/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp
